# 提供站点地址与 AI 助手代理的环境变量示例

NEXT_PUBLIC_SITE_URL=http://localhost:3000
AGENT_API_BASE_URL=http://127.0.0.1:6001
AGENT_API_SECRET=replace-with-the-same-long-random-secret-as-agent
# 普通 AI 助手路由的函数执行预算为六十秒
AGENT_REQUEST_TIMEOUT_MS=45000
# 流式路由的 Hobby 执行预算为三百秒，预留五秒用于响应收尾
AGENT_STREAM_TIMEOUT_MS=295000
# 流式请求在业务进度停滞达到此时长后取消
AGENT_STREAM_IDLE_TIMEOUT_MS=180000
