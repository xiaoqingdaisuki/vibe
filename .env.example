NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 仅用于四位房友人房的临时 WebSocket 信令/转发服务，不保存牌局数据
NEXT_PUBLIC_MAHJONG_SIGNAL_URL=ws://localhost:8787
AGENT_API_BASE_URL=http://127.0.0.1:6001
