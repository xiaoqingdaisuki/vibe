# ECS 公网访问地址。绑定域名后可改为 https://your-domain.example。
NEXT_PUBLIC_SITE_URL=http://your-ecs-public-ip

# ECS 安全组需要放行该 TCP 端口。
APP_PORT=80

# AI 服务地址，不要包含 /chat 或 /images/generations 路径。
# 如果服务运行在 ECS 宿主机的 6001 端口，改为 http://host.docker.internal:6001。
AGENT_API_BASE_URL=https://agent-production-49c1.up.railway.app
